{
  "name": "textfixer",
  "version": "1.0.0",
  "description": "A cross-platform text utility app.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "text",
    "utility",
    "electron",
    "hebrew",
    "translation",
    "gpt"
  ],
  "author": "Manus",
  "license": "ISC",
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "node-fetch": "^2.7.0",
    "openai": "^4.96.2"
  },
  "build": {
    "appId": "com.manus.textfixer",
    "productName": "TextFixer",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "utils/",
      "node_modules/"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
